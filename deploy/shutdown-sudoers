# Installed to /etc/sudoers.d/haphazardnet-shutdown (mode 0440).
# Lets the unprivileged panel user power off / reboot the box — and ONLY those —
# for the slide-to-confirm Shutdown / Reboot controls in the web UI.
haphazardnet ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot
