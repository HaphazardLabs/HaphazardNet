[Unit]
Description=HaphazardNet control panel (web UI)
After=network.target

[Service]
Type=simple
# Unprivileged: the panel only READS state + WRITES the requested mode to
# /etc/haphazard/mode.json. The root applier (haphazard-mode) acts on it.
User=haphazardnet
Group=haphazardnet
SupplementaryGroups=i2c
WorkingDirectory=/opt/haphazardnet
ExecStart=/usr/bin/python3 /opt/haphazardnet/server.py --port 80 --portal-ip 192.168.10.1
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/etc/haphazard /run/haphazard
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
